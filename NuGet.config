<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Central package management (NU1507) rejects multiple package sources without
    source mapping. Every dependency here is public, so clear any machine- or
    user-level feeds and pin restore to nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
